{
  "name": "maccms-cf",
  "version": "1.0.0",
  "description": "MacCMS rebuilt for Cloudflare Workers + Pages + D1 with v8/v10 features",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "d1:init": "wrangler d1 execute maccms-db --local --file=./schema.sql",
    "d1:init-remote": "wrangler d1 execute maccms-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.151.2"
  }
}
